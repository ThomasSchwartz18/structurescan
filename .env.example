# Confluence environment configuration.
#
# Copy this file to `.env` in the repo root and fill in what you need.
# See SETUP.md for the full walkthrough. Nothing in this file is
# required to run the app with mock data — every setting has a
# mock-friendly default.

# Which DataProvider backs the screener/watchlist:
#   mock  - MockDataProvider, synthetic data (default)
#   real  - RealDataProvider, Binance's public REST API
# Binance's market-data endpoints need NO API key — just network access
# to api.binance.com. Leave this unset (or "mock") to keep using
# synthetic data.
CONFLUENCE_DATA_PROVIDER=mock

# Etherscan API key, for the wallet-scan feature's real implementation.
# NOT YET USED BY ANY CODE — today the wallet scan only has
# MockWalletProvider. This variable name is reserved so it's ready once
# a RealWalletProvider is built (see SETUP.md's wallet section). Get a
# free key at https://etherscan.io/apis if/when you build that.
ETHERSCAN_API_KEY=
